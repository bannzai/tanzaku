{
  "sourceLanguage" : "en",
  "strings" : {
    "Image" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像"
          }
        }
      }
    },
    "Only images and videos can be added. This file is %@." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加できるのは画像と動画だけです。このファイルの種類は %@ です"
          }
        }
      }
    },
    "The image or video is too large. Choose one that is %@ or smaller." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像・動画が大きすぎます。%@ 以下のものを選んでください"
          }
        }
      }
    },
    "The keyword \"%@\" is already used by another snippet or snippet group." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーワード「%@」は別のスニペットかスニペットグループで使われています"
          }
        }
      }
    },
    "The keyword cannot be only spaces." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーワードを空白だけにはできません"
          }
        }
      }
    },
    "The keyword must be at least %lld characters." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーワードは %lld 文字以上にしてください"
          }
        }
      }
    },
    "The snippet body is empty." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本文が空です"
          }
        }
      }
    },
    "The snippet was not found. It may have been deleted." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スニペットが見つかりません。削除された可能性があります"
          }
        }
      }
    },
    "This snippet holds an image or video, so its body cannot be set." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスニペットは画像・動画を持つため本文を設定できません"
          }
        }
      }
    },
    "Video" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画"
          }
        }
      }
    },
    "This build doesn’t sync with iCloud. Snippets are kept on this device." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビルドは iCloud と同期しません。スニペットはこの端末に保存します。"
          }
        }
      }
    },
    "Checking iCloud…" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud を確認しています…"
          }
        }
      }
    },
    "Snippets sync with your other devices through iCloud." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スニペットは iCloud でほかの端末と同期します。"
          }
        }
      }
    },
    "You aren’t signed in to iCloud. Snippets are kept on this device until you sign in." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud にサインインしていません。サインインするまでスニペットはこの端末に保存します。"
          }
        }
      }
    },
    "Your iCloud storage is full, so changes aren’t synced. Snippets are kept on this device." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud の容量が足りないため、変更を同期できません。スニペットはこの端末に保存します。"
          }
        }
      }
    },
    "iCloud isn’t available right now. Snippets are kept on this device." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud を今は使えません。スニペットはこの端末に保存します。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
